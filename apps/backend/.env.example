DATABASE_URL=postgres://proofchain:proofchain@localhost:5433/proofchain
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
PHOTO_STORAGE_DIR=./var/photos
# How far a device clock may drift from server time before we flag it (seconds)
MAX_CLOCK_SKEW_SECONDS=900
# Shared secret the anchor worker presents on POST /batches/:id/anchor (x-anchor-worker-token header)
ANCHOR_WORKER_TOKEN=change-me-in-production

# ---------------------------------------------------------------------------
# Deployment settings. The defaults below are the local ones; the comments say
# what each becomes on a hosted instance.
# ---------------------------------------------------------------------------

# How many proxies sit in front of this service. Unset means "none", so
# X-Forwarded-For is ignored and req.ip is the real peer.
#
#   Behind Render/Railway/Fly/Heroku : TRUST_PROXY=1
#   Behind Cloudflare + a platform LB: TRUST_PROXY=2
#   A local reverse proxy            : TRUST_PROXY=loopback
#
# Getting this wrong breaks rate limiting in one of two directions: too low and
# every client shares one bucket; too high (or `true`) and a client can forge
# the header to get a fresh bucket per request. See src/config/trust-proxy.ts.
# TRUST_PROXY=1

# TLS to Postgres. Normally leave this unset: a loopback or private-network
# host connects in plaintext, and anything else is verified with the system CA
# store — which is what Neon, Supabase, RDS and Render all need.
#
#   DATABASE_SSL=require    force verified TLS (e.g. a public host without sslmode)
#   DATABASE_SSL=no-verify  encrypted but unverified — only for a self-signed dev server
#   DATABASE_SSL=disable    plaintext
#
# A provider with a private CA supplies it as a PEM in DATABASE_SSL_CA, which
# also forces verification back on.
# DATABASE_SSL=require
# DATABASE_SSL_CA=

# ---------------------------------------------------------------------------
# Used only by `npm run admin:create`, which creates the first administrator on
# a freshly migrated database (the dev seed refuses to run in production). Set
# these on the command line rather than in this file so the password does not
# sit on disk:
#
#   ADMIN_EMAIL=you@example.com ADMIN_PASSWORD='…' npm run admin:create
#
# Add ADMIN_RESET_PASSWORD=true to reset an existing account instead.
# ---------------------------------------------------------------------------
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
