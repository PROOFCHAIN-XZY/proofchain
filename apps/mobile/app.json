{
  "expo": {
    "name": "ProofChain Collect",
    "slug": "proofchain-collect",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "proofchain",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "org.proofchain.collect",
      "permissions": [
        "CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "org.proofchain.collect",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Photographs each weigh-in so the record can be audited."
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Photographs each weigh-in so the record can be audited."
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
