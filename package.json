{
  "name": "proofchain",
  "private": true,
  "version": "0.1.0",
  "description": "Verified waste-to-credit platform on Stellar (testnet phase)",
  "workspaces": [
    "packages/*",
    "apps/backend",
    "apps/dashboard",
    "apps/capture",
    "apps/mobile",
    "services/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:up": "docker compose -f infra/docker-compose.yml up -d postgres redis",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "stack:up": "docker compose -f infra/docker-compose.yml up -d",
    "stellar:account": "node services/anchor-worker/scripts/create-testnet-account.mjs",
    "migrate": "npm run migration:run -w @proofchain/backend",
    "seed": "npm run seed -w @proofchain/backend",
    "dev:backend": "npm run start:dev -w @proofchain/backend",
    "dev:dashboard": "npm run dev -w @proofchain/dashboard",
    "dev:capture": "npm run dev -w @proofchain/capture",
    "dev:mobile": "npm run start -w @proofchain/mobile",
    "worker": "npm run start -w @proofchain/anchor-worker",
    "demo": "node scripts/demo-e2e.mjs",
    "e2e:dashboard": "node e2e/dashboard.mjs",
    "e2e:capture": "node e2e/capture.mjs",
    "e2e": "npm run e2e:dashboard && npm run e2e:capture && npm run e2e:sw",
    "e2e:sw": "node e2e/service-worker.mjs",
    "dev:capture:https": "npm run dev:https -w @proofchain/capture",
    "hub:relocate": "npm run hub:relocate -w @proofchain/backend --"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "playwright": "^1.49.0"
  }
}
