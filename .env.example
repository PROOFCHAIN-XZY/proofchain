# ---- Postgres (backend + docker compose) ----
POSTGRES_USER=proofchain
POSTGRES_PASSWORD=proofchain
POSTGRES_DB=proofchain
DATABASE_URL=postgres://proofchain:proofchain@localhost:5433/proofchain

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6380

# ---- Backend ----
PORT=3000
JWT_SECRET=change-me-in-production
# Comma-separated device public keys are stored per-collector in the DB, not here.

# ---- Stellar (testnet) ----
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_SECRET=
# Backend-side ceiling on a Horizon read. Verification is a public endpoint, so
# this bounds how long an unauthenticated request can hold a worker.
HORIZON_TIMEOUT_MS=8000

# ---- Reverse geocoding (hub place names, cosmetic) ----
# Turns a hub coordinate into "Kaduna, Nigeria" for audit reports. One lookup per
# hub, ever — every event sits inside the hub geofence, so they all share a label.
# The label never enters a signed payload or a Merkle leaf: a report that only
# verified while a geocoder agreed with us would not be independently verifiable.
#
# Leave NOMINATIM_USER_AGENT empty to disable the feature entirely. OSM's public
# instance requires a genuine identifying agent with contact details and blocks
# generic ones, so an unset value means "do not call" rather than "call anonymously".
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=
NOMINATIM_TIMEOUT_MS=5000

# ---- Weigh-in photos ----
# Filesystem path; needs a mounted volume and a backup policy in any real
# deployment. Contains personal data about identifiable collectors.
PHOTO_STORAGE_DIR=./var/photos
MAX_PHOTO_BYTES=8388608
